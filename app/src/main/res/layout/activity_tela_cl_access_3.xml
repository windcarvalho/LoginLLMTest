<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Rótulo e campo de nome -->
    <TextView
        android:id="@+id/textViewNomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome:"
        android:labelFor="@id/editTextNome"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite seu nome"
        android:inputType="textPersonName"
        android:importantForAccessibility="yes"
        android:contentDescription="Campo de nome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewNomeLabel"
        app:layout_constraintTop_toTopOf="@id/textViewNomeLabel" />

    <!-- Rótulo e campo de sobrenome -->
    <TextView
        android:id="@+id/textViewSobrenomeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sobrenome:"
        android:labelFor="@id/editTextSobrenome"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextNome" />

    <EditText
        android:id="@+id/editTextSobrenome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite seu sobrenome"
        android:inputType="textPersonName"
        android:importantForAccessibility="yes"
        android:contentDescription="Campo de sobrenome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewSobrenomeLabel"
        app:layout_constraintTop_toBottomOf="@id/editTextNome" />

    <!-- Rótulo e campo de e-mail -->
    <TextView
        android:id="@+id/textViewEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E-mail:"
        android:labelFor="@id/editTextEmail"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextSobrenome" />

    <EditText
        android:id="@+id/editTextEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite seu e-mail"
        android:inputType="textEmailAddress"
        android:importantForAccessibility="yes"
        android:contentDescription="Campo de e-mail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewEmailLabel"
        app:layout_constraintTop_toBottomOf="@id/editTextSobrenome" />

    <!-- Rótulo e campo de senha -->
    <TextView
        android:id="@+id/textViewSenhaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Senha:"
        android:labelFor="@id/editTextSenha"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextEmail" />

    <EditText
        android:id="@+id/editTextSenha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Digite sua senha"
        android:inputType="textPassword"
        android:importantForAccessibility="yes"
        android:contentDescription="Campo de senha"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewSenhaLabel"
        app:layout_constraintTop_toBottomOf="@id/editTextEmail" />

    <!-- Rótulo e campo de data de nascimento -->
    <TextView
        android:id="@+id/textViewDataNascimentoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data de Nascimento:"
        android:labelFor="@id/editTextDataNascimento"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextSenha" />

    <EditText
        android:id="@+id/editTextDataNascimento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="DD/MM/AAAA"
        android:inputType="date"
        android:importantForAccessibility="yes"
        android:contentDescription="Campo de data de nascimento"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewDataNascimentoLabel"
        app:layout_constraintTop_toBottomOf="@id/editTextSenha" />

    <!-- Rótulo e campo de gênero -->
    <TextView
        android:id="@+id/textViewGeneroLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gênero:"
        android:labelFor="@id/spinnerGenero"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextDataNascimento" />

    <Spinner
        android:id="@+id/spinnerGenero"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:contentDescription="Selecione seu gênero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/textViewGeneroLabel"
        app:layout_constraintTop_toBottomOf="@id/editTextDataNascimento" />

    <!-- Botões -->
    <Button
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enviar"
        android:importantForAccessibility="yes"
        android:contentDescription="Botão para enviar o formulário"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinnerGenero" />

    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancelar"
        android:importantForAccessibility="yes"
        android:contentDescription="Botão para cancelar o formulário"
        app:layout_constraintEnd_toStartOf="@id/btnEnviar"
        app:layout_constraintTop_toBottomOf="@id/spinnerGenero" />

</androidx.constraintlayout.widget.ConstraintLayout>