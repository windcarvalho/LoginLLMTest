<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botão de Voltar -->
    <Button
        android:id="@+id/btnPrevious"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/previous"
        android:contentDescription="@string/previous_song"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"/>

    <!-- Botão de Reproduzir/Pausar -->
    <Button
        android:id="@+id/btnPlayPause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/play"
        android:contentDescription="@string/play_pause"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"/>

    <!-- Botão de Avançar -->
    <Button
        android:id="@+id/btnNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/next"
        android:contentDescription="@string/next_song"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>

    <!-- Barra de Progresso -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnPlayPause"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/seek_bar"/>

    <!-- Lista de Reprodução -->
    <ListView
        android:id="@+id/playlistListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/seekBar"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/playlist"/>

    <!-- Informações da Música Atual -->
    <TextView
        android:id="@+id/textCurrentSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/playlistListView"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:text="@string/current_song_info"/>

</RelativeLayout>