<?xml version="1.0" encoding="utf-8"?>
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="org.ufc.great.llm.screens.Tela_CL_1">

        <!-- Imagem do Produto -->
        <ImageView
            android:id="@+id/imageViewProduto"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nome do Produto -->
        <TextView
            android:id="@+id/textViewNomeProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nome do Produto"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageViewProduto" />

        <!-- Preço do Produto -->
        <TextView
            android:id="@+id/textViewPrecoProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="R$ 100,00"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewNomeProduto" />

        <!-- Descrição do Produto -->
        <TextView
            android:id="@+id/textViewDescricaoProduto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Descrição do Produto"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewPrecoProduto" />

        <!-- Botão Adicionar ao Carrinho -->
        <Button
            android:id="@+id/buttonAdicionarCarrinho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar ao Carrinho"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewDescricaoProduto" />

        <!-- Botão Adicionar aos Favoritos -->
        <Button
            android:id="@+id/buttonAdicionarFavoritos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar aos Favoritos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonAdicionarCarrinho" />

</androidx.constraintlayout.widget.ConstraintLayout>
